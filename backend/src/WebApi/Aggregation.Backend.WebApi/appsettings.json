{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning",
        "System.Net.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log_.json",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "renderMessage": true,
          "restrictedToMinimumLevel": "Information",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "fileSizeLimitBytes": 20480000
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ExternalIdProviderOptions": {
    "BaseUrl": "https://api.github.com",
    "TokenUrl": "https://github.com/login/oauth/access_token",
    "Scope":"email,name",
    "ClientId": "<github-client-id>",
    "ClientSecret": "<github-client-secret>"
  },
  "AirPollutionOptions": {
    "BaseUrl": "",
    "ApiKey": "",
    "GetUri": "",
    "ListUri": ""
  },
  "NewsOptions": {
    "BaseUrl": "",
    "ApiKey": "",
    "ListUri": ""
  },
  "StockMarketFeedOptions": {
    "BaseUrl": "",
    "ApiKey": "",
    "ListUri": ""
  },

  "StatisticsAnalyzerServiceOptions": {
    "CronExpression": "*/5 * * * *"
  },
  "JwtOptions": {
    "Issuer": "https://localhost:7064",
    "Audience": "https://localhost:7064",
    "SecretKey": "cUduSmV0dDdFTE5lVFBoUGFRaUZVbWtrNTZyR0ZaMVhCeElLYWZIa1RaOHhoUndUbXZLc0tWbTRGTHFWcjZPMA=="
  },
  "BucketOptions": {
    "FastUpperLimit": 150,
    "AverageUpperLimit": 300
  },
  "ConnectionStrings": {
    "AggregationBackendIdentityDbContext": "Host=localhost;Port=5432;Username=postgres;Password=mysecretpassword;Database=aggregation_backend_dev"
  }
}
