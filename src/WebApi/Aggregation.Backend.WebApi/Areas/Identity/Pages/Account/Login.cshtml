@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        <section>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="/" method="post">
                @foreach (var provider in Model.ExternalLogins)
                {
                    <button type="submit" class="w-100 btn btn-lg btn-dark" name="provider" value="@provider.Name">Sign in with @provider.DisplayName</button>
                }
            </form>
        </section>
    </div>
</div>
